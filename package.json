{
  "name": "guild-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:guild": "npm run dev --workspace=apps/guild-web",
    "dev:admin": "npm run dev --workspace=apps/admin-web",
    "build:guild": "npm run build --workspace=apps/guild-web",
    "build:admin": "npm run build --workspace=apps/admin-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
