# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Gemini API (optional, for AI features)
# GEMINI_API_KEY=your_gemini_key

# Razorpay — Key ID is public and safe for frontend. Secret is server-side ONLY.
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# The Razorpay Key Secret must ONLY appear in server-side env vars (e.g. Vercel env, not committed)
# RAZORPAY_KEY_SECRET=your_razorpay_secret

# Billing Config
VITE_ANNUAL_OFFER_END_DATE=2026-09-30   # ISO date when 50% annual discount expires
VITE_ENTERPRISE_CONTACT_URL=mailto:enterprise@yourcompany.com
