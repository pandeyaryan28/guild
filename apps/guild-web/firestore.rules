rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────
    
    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Get the user's profile document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if the user belongs to the specified organization
    function isMemberOfOrg(orgId) {
      return isAuth() && getUserData().organizationId == orgId;
    }

    // Check if the document belongs to the user's organization
    function isDocInMyOrg() {
      return isAuth() && getUserData().organizationId == resource.data.orgId;
    }

    // Check if the incoming document to be created/written belongs to the user's organization
    function isNewDocInMyOrg() {
      return isAuth() && getUserData().organizationId == request.resource.data.orgId;
    }

    // Get the orgId of a DM thread by its ID
    function getDmOrgId(dmId) {
      return get(/databases/$(database)/documents/directMessages/$(dmId)).data.orgId;
    }

    // Check if the user is the owner of the specified organization
    function isOrgOwner(orgId) {
      return isAuth() && 
        getUserData().organizationId == orgId && 
        getUserData().role == 'owner';
    }

    // Check if the user is an admin or owner of the specified organization
    function isOrgAdminOrOwner(orgId) {
      return isAuth() && 
        getUserData().organizationId == orgId && 
        (getUserData().role == 'owner' || getUserData().role == 'admin');
    }

    // ─── USER PROFILES & ACCOUNTS ───────────────────────────────────────────

    match /users/{userId} {
      // Users can read their own profile or profiles in the same organization
      allow read: if isAuth() && (
        request.auth.uid == userId || 
        getUserData().organizationId == resource.data.organizationId
      );
      
      // Creating a user profile
      allow create: if isAuth() && request.auth.uid == userId && (
        // A user can create their own profile with role 'member'
        (request.resource.data.role == 'member') ||
        // Or with role 'owner' only if they are the verified owner of the organization they are setting
        (request.resource.data.role == 'owner' && 
         get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == userId)
      );

      // Updating a user profile
      allow update: if isAuth() && (
        // A user can update their own details, but NOT their role or organizationId
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.organizationId == resource.data.organizationId) ||
        // Or an organization admin or owner can modify them
        isOrgAdminOrOwner(resource.data.organizationId)
      );

      // Deleting a user profile
      allow delete: if isAuth() && (
        request.auth.uid == userId ||
        (resource != null && isOrgAdminOrOwner(resource.data.organizationId))
      );
    }

    match /usernames/{username} {
      // Publicly readable for uniqueness checking during registration
      allow read: if true;
      allow write: if isAuth();
    }

    match /onboardingState/{userId} {
      // Users can manage their own onboarding state
      allow read, write: if isAuth() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(userId)) && 
         isOrgOwner(get(/databases/$(database)/documents/users/$(userId)).data.organizationId))
      );
    }

    // ─── ORGANIZATIONS & MEMBERSHIP ──────────────────────────────────────────

    match /organizations/{orgId} {
      // Any authenticated user can create an organization
      allow create: if isAuth();
      // Members of the organization can read/update it
      allow read: if isMemberOfOrg(orgId);
      // Only owners/admins can update organization details or delete it
      allow update: if isMemberOfOrg(orgId) && (getUserData().role == 'owner' || getUserData().role == 'admin');
      allow delete: if isMemberOfOrg(orgId) && getUserData().role == 'owner';

      // ── Billing sub-document: owner only ──────────────────────────────────
      match /billing/{docId} {
        allow read: if isMemberOfOrg(orgId) && getUserData().role == 'owner';
        allow write: if isMemberOfOrg(orgId) && getUserData().role == 'owner';
      }

      // ── Billing transactions: owner can read/write ─────────────────────────
      match /billingTransactions/{txId} {
        allow read: if isMemberOfOrg(orgId) && getUserData().role == 'owner';
        allow create: if isMemberOfOrg(orgId) && getUserData().role == 'owner';
        // Transactions are immutable after creation
        allow update, delete: if false;
      }
    }

    match /organizationMembers/{memberId} {
      // memberId is in format orgId_userId
      // Members of the organization can read members list
      allow read: if isAuth() && isMemberOfOrg(resource.data.orgId);
      // Creating or updating a membership record
      allow create, update, delete: if isAuth() && (
        // A user onboarding can add themselves as a member
        (request.auth.uid == request.resource.data.userId && request.resource.data.role == 'member') ||
        // A workspace owner can add themselves as the owner
        (request.auth.uid == request.resource.data.userId && 
         request.resource.data.role == 'owner' && 
         get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.ownerId == request.auth.uid) ||
        // Or the owner/admin can manage it
        (isMemberOfOrg(resource.data.orgId) && (getUserData().role == 'owner' || getUserData().role == 'admin')) ||
        (isMemberOfOrg(request.resource.data.orgId) && (getUserData().role == 'owner' || getUserData().role == 'admin'))
      );
    }

    match /inviteLinks/{token} {
      // Allow anyone to GET a specific invite link by token.
      // The token itself is randomly generated and serves as the shared secret —
      // if you have the URL you're already authorised to see its content.
      allow get: if true;
      // Listing all invite links for an org is restricted to admins/owners
      allow list: if isAuth() && isOrgAdminOrOwner(resource.data.orgId);
      // Allow creation only by org owners and admins
      allow create: if isAuth() && isOrgAdminOrOwner(request.resource.data.orgId);
      // Allow update by org owners/admins OR when only useCount is updated (by onboarding user)
      allow update: if isAuth() && (
        isOrgAdminOrOwner(resource.data.orgId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])
      );
      // Allow deletion only by org owners and admins
      allow delete: if isAuth() && isOrgAdminOrOwner(resource.data.orgId);
    }

    // ─── CHANNELS, TEAMS, PROJECTS, GOALS, TASKS & OPERATIONS ────────────────

    // All these collections are partitioned by 'orgId'
    
    match /channels/{channelId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /channelMembers/{memberId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /teams/{teamId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /projects/{projectId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
      
      // Subcollection for project milestones
      match /milestones/{milestoneId} {
        allow read: if isMemberOfOrg(resource.data.orgId);
        allow write: if isNewDocInMyOrg() || isDocInMyOrg();
      }
    }

    match /goals/{goalId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        request.auth.uid == resource.data.ownerId ||
        getUserData().role == 'owner' ||
        getUserData().role == 'admin'
      );
    }

    match /tasks/{taskId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        request.auth.uid == resource.data.creatorId ||
        getUserData().role == 'owner' ||
        getUserData().role == 'admin'
      );
    }

    match /requests/{requestId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }


    match /taskActivities/{activityId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /taskComments/{commentId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /taskLabels/{labelId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /projectComments/{commentId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /goalComments/{commentId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    // ─── CHAT MESSAGES & THREADS ────────────────────────────────────────────

    match /messages/{messageId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /messageReplies/{replyId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /directMessages/{threadId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow write: if isNewDocInMyOrg() || isDocInMyOrg();
    }

    match /dmReadState/{stateId} {
      allow read: if isAuth() && isMemberOfOrg("orgId" in resource.data ? resource.data.orgId : getDmOrgId(resource.data.dmId));
      allow write: if isAuth() && (
        // Allow if the user is writing/deleting their own read state
        (request.auth.uid == (resource == null ? request.resource.data.userId : resource.data.userId)) ||
        // Or if the read state falls under the user's organization
        isMemberOfOrg(
          resource != null 
            ? ("orgId" in resource.data ? resource.data.orgId : getDmOrgId(resource.data.dmId))
            : ("orgId" in request.resource.data ? request.resource.data.orgId : getDmOrgId(request.resource.data.dmId))
        )
      );
    }

    // ─── NOTIFICATIONS ──────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      // Users can read/write notifications addressed to them
      allow read, write: if isAuth() && request.auth.uid == resource.data.recipientId;
      // Allow creation of notifications for others in the same organization
      allow create: if isAuth() && isNewDocInMyOrg();
    }
    // ─── BANNED USERS ────────────────────────────────────────────────────────
    // Written when an org owner/admin deletes a member to block re-login.

    match /bannedUsers/{uid} {
      // The banned user themselves can read their own ban record (to show a message)
      allow read: if isAuth() && (
        request.auth.uid == uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         isOrgAdminOrOwner(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId))
      );
      // Only org owners/admins can ban a user
      allow create: if isAuth() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isOrgAdminOrOwner(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId)
      );
      // Only org owners can remove a ban
      allow delete: if isAuth() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isOrgOwner(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId)
      );
      allow update: if false;
    }
  }
}