rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the target userId
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Check if the caller's user profile document exists
    function userExists() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Get the caller's user profile document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if the user belongs to the specified organization
    function isMemberOfOrg(orgId) {
      return isAuth() && userExists() && getUserData().organizationId == orgId;
    }

    // Check if the existing document belongs to the user's organization
    function isDocInMyOrg() {
      return isAuth() && resource != null && userExists() && getUserData().organizationId == resource.data.orgId;
    }

    // Check if the incoming document to be created/written belongs to the user's organization
    // Also supports atomic onboarding batches where the user document is created in the same batch
    function isNewDocInMyOrg() {
      return isAuth() && request.resource != null && (
        (userExists() && getUserData().organizationId == request.resource.data.orgId) ||
        (existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == request.resource.data.orgId)
      );
    }

    // Get the orgId of a DM thread by its ID
    function getDmOrgId(dmId) {
      return get(/databases/$(database)/documents/directMessages/$(dmId)).data.orgId;
    }

    // Check if the user is the owner of the specified organization
    function isOrgOwner(orgId) {
      return isAuth() && userExists() &&
        getUserData().organizationId == orgId &&
        getUserData().role == 'owner';
    }

    // Check if the user is an admin or owner of the specified organization
    function isOrgAdminOrOwner(orgId) {
      return isAuth() && userExists() &&
        getUserData().organizationId == orgId &&
        (getUserData().role == 'owner' || getUserData().role == 'admin');
    }

    // Check if the user is a manager, admin, or owner of the specified organization
    function isOrgManagerOrAbove(orgId) {
      return isAuth() && userExists() &&
        getUserData().organizationId == orgId &&
        (getUserData().role in ['owner', 'admin', 'manager'] ||
         ('isManager' in getUserData() && getUserData().isManager == true));
    }

    // ─── USER PROFILES & ACCOUNTS ───────────────────────────────────────────

    match /users/{userId} {
      // Users can read their own profile or profiles in the same organization
      allow read: if isAuth() && (
        isOwner(userId) ||
        (userExists() && getUserData().organizationId == resource.data.organizationId)
      );

      // Allow user to create their own profile during onboarding/invite acceptance,
      // or allow an org admin/owner to create a member profile in their organization
      allow create: if isAuth() && (
        (isOwner(userId) && request.resource.data.role in ['owner', 'admin', 'manager', 'member']) ||
        isOrgAdminOrOwner(request.resource.data.organizationId)
      );

      // Allow user to update their own profile fields (or set organizationId/role when joining an org),
      // while preventing an already-assigned member from escalating their own role within the same org.
      // Org admins/owners can update members in their org, and managers can set isManager on team leads.
      allow update: if isAuth() && (
        (isOwner(userId) && (
          (request.resource.data.role == resource.data.role &&
           request.resource.data.organizationId == resource.data.organizationId) ||
          ((!('organizationId' in resource.data) ||
            resource.data.organizationId == null ||
            resource.data.organizationId == '' ||
            request.resource.data.organizationId != resource.data.organizationId) &&
           request.resource.data.role in ['owner', 'admin', 'manager', 'member'])
        )) ||
        isOrgAdminOrOwner(resource.data.organizationId) ||
        (isOrgManagerOrAbove(resource.data.organizationId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isManager', 'updatedAt']))
      );

      // Users can delete their own profile or org admins/owners can remove members
      allow delete: if isAuth() && (
        isOwner(userId) ||
        (resource != null && isOrgAdminOrOwner(resource.data.organizationId))
      );
    }

    match /usernames/{username} {
      // Publicly readable for uniqueness checking during registration
      allow read: if true;
      // Allow creation only if claiming for oneself
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      // Allow update or delete by the owner of the username or an org admin/owner cleaning up a removed user
      allow update, delete: if isAuth() && (
        resource.data.uid == request.auth.uid ||
        (userExists() && (getUserData().role == 'owner' || getUserData().role == 'admin'))
      );
    }

    match /onboardingState/{userId} {
      // Users can manage their own onboarding state; org owners/admins can clean it up on member deletion
      allow read, write: if isAuth() && (
        isOwner(userId) ||
        (exists(/databases/$(database)/documents/users/$(userId)) &&
         isOrgAdminOrOwner(get(/databases/$(database)/documents/users/$(userId)).data.organizationId))
      );
    }

    // ─── ORGANIZATIONS & MEMBERSHIP ──────────────────────────────────────────

    match /organizations/{orgId} {
      // Any authenticated user can read org metadata (required for validateInviteToken,
      // findOrgByAutoJoinDomain, and onboarding checks before joining the org)
      allow read: if isAuth();

      // Any authenticated user can create an organization with themselves as owner
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;

      // Org admins/owners can update org settings, OR an authenticated user can add themselves
      // to the members array when joining via invite link or auto-join domain
      allow update: if isOrgAdminOrOwner(orgId) || (
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount', 'updatedAt'])
      );

      // Only the organization owner can delete the organization
      allow delete: if isOrgOwner(orgId);

      // ── Billing sub-document: owner only ──────────────────────────────────
      match /billing/{docId} {
        allow read, write: if isOrgOwner(orgId);
      }

      // ── Billing transactions: owner can read/create, immutable thereafter ─
      match /billingTransactions/{txId} {
        allow read, create: if isOrgOwner(orgId);
        allow update, delete: if false;
      }
    }

    match /organizationMembers/{memberId} {
      // memberId is in format orgId_userId
      allow read: if isAuth() && (
        isMemberOfOrg(resource.data.orgId) ||
        resource.data.userId == request.auth.uid
      );

      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid ||
        isOrgAdminOrOwner(request.resource.data.orgId)
      );

      allow update: if isAuth() && (
        isOrgAdminOrOwner(resource.data.orgId) ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.role == resource.data.role)
      );

      allow delete: if isAuth() && (
        isOrgAdminOrOwner(resource.data.orgId) ||
        resource.data.userId == request.auth.uid
      );
    }

    match /inviteLinks/{token} {
      // Allow single-token lookup and authenticated listing/validation during onboarding & invite acceptance
      allow get: if true;
      allow list: if isAuth();

      // Allow creation by org admins/owners or during the initial org creation batch
      allow create: if isAuth() && (
        isOrgAdminOrOwner(request.resource.data.orgId) ||
        isNewDocInMyOrg() ||
        request.resource.data.createdBy == request.auth.uid
      );

      // Allow update by org admins/owners OR when an onboarding user increments useCount
      allow update: if isAuth() && (
        isOrgAdminOrOwner(resource.data.orgId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount', 'usedCount', 'usedBy', 'updatedAt'])
      );

      // Allow deletion by org admins/owners
      allow delete: if isAuth() && (
        isOrgAdminOrOwner(resource.data.orgId) ||
        isDocInMyOrg()
      );
    }

    match /pendingInvites/{inviteId} {
      allow read: if isAuth() && (
        isDocInMyOrg() ||
        isOrgAdminOrOwner(resource.data.orgId)
      );
      allow create: if isAuth() && (
        isNewDocInMyOrg() ||
        isOrgAdminOrOwner(request.resource.data.orgId)
      );
      allow update: if isAuth() && (
        isDocInMyOrg() ||
        isNewDocInMyOrg() ||
        isOrgAdminOrOwner(resource.data.orgId)
      );
      allow delete: if isAuth() && (
        isDocInMyOrg() ||
        isOrgAdminOrOwner(resource.data.orgId)
      );
    }

    // ─── CHANNELS, TEAMS, PROJECTS, GOALS, TASKS & OPERATIONS ────────────────

    match /channels/{channelId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        isOrgAdminOrOwner(resource.data.orgId) ||
        resource.data.createdBy == request.auth.uid
      );
    }

    match /channelMembers/{memberId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update, delete: if isDocInMyOrg();
    }

    match /canvases/{canvasId} {
      allow get: if isAuth() && (resource == null || isMemberOfOrg(resource.data.orgId));
      allow list: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update, delete: if isDocInMyOrg();
    }

    match /teams/{teamId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg() && (
        isOrgAdminOrOwner(request.resource.data.orgId) ||
        getUserData().role == 'manager' ||
        ('isManager' in getUserData() && getUserData().isManager == true)
      );
      allow update, delete: if isDocInMyOrg() && (
        isOrgAdminOrOwner(resource.data.orgId) ||
        resource.data.managerId == request.auth.uid ||
        getUserData().role == 'manager' ||
        ('isManager' in getUserData() && getUserData().isManager == true)
      );
    }

    match /projects/{projectId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update, delete: if isDocInMyOrg();

      // Subcollection for project milestones
      match /milestones/{milestoneId} {
        allow read: if isMemberOfOrg(resource.data.orgId);
        allow create: if isNewDocInMyOrg();
        allow update, delete: if isDocInMyOrg();
      }
    }

    match /goals/{goalId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        request.auth.uid == resource.data.ownerId ||
        isOrgAdminOrOwner(resource.data.orgId) ||
        getUserData().role == 'manager' ||
        ('isManager' in getUserData() && getUserData().isManager == true)
      );
    }

    match /tasks/{taskId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        resource.data.creatorId == request.auth.uid ||
        isOrgAdminOrOwner(resource.data.orgId) ||
        getUserData().role == 'manager' ||
        ('isManager' in getUserData() && getUserData().isManager == true)
      );
    }

    match /requests/{requestId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isDocInMyOrg() && (
        !(request.resource.data.status in ['approved', 'rejected'] && resource.data.status == 'pending') ||
        (
          (request.auth.uid != resource.data.creatorId || isOrgOwner(resource.data.orgId)) &&
          (resource.data.approverId == request.auth.uid ||
           isOrgAdminOrOwner(resource.data.orgId) ||
           getUserData().role == 'manager' ||
           ('isManager' in getUserData() && getUserData().isManager == true))
        )
      );
      allow delete: if isDocInMyOrg() && (
        resource.data.creatorId == request.auth.uid ||
        isOrgAdminOrOwner(resource.data.orgId) ||
        getUserData().role == 'manager' ||
        ('isManager' in getUserData() && getUserData().isManager == true)
      );
    }

    match /taskActivities/{activityId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update, delete: if isDocInMyOrg();
    }

    match /taskComments/{commentId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg() && request.resource.data.authorId == request.auth.uid;
      allow update: if isDocInMyOrg() && resource.data.authorId == request.auth.uid;
      allow delete: if isDocInMyOrg();
    }

    match /taskLabels/{labelId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update, delete: if isDocInMyOrg();
    }

    match /projectComments/{commentId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg() && request.resource.data.authorId == request.auth.uid;
      allow update: if isDocInMyOrg() && resource.data.authorId == request.auth.uid;
      allow delete: if isDocInMyOrg();
    }

    match /goalComments/{commentId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg() && request.resource.data.authorId == request.auth.uid;
      allow update: if isDocInMyOrg() && resource.data.authorId == request.auth.uid;
      allow delete: if isDocInMyOrg();
    }

    // ─── WORKSPACE (DOCUMENTS, ISSUES, CYCLES & DATABASES) ───────────────────

    match /workspaceDocuments/{documentId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        ('createdBy' in resource.data && request.auth.uid == resource.data.createdBy) ||
        ('creatorId' in resource.data && request.auth.uid == resource.data.creatorId) ||
        isOrgAdminOrOwner(resource.data.orgId)
      );
    }

    match /workspaceIssues/{issueId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        ('creatorId' in resource.data && request.auth.uid == resource.data.creatorId) ||
        ('createdBy' in resource.data && request.auth.uid == resource.data.createdBy) ||
        isOrgAdminOrOwner(resource.data.orgId)
      );
    }

    match /workspaceCycles/{cycleId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg() && (
        getUserData().role == 'owner' ||
        getUserData().role == 'admin' ||
        getUserData().role == 'member' ||
        getUserData().role == 'manager'
      );
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && isOrgAdminOrOwner(resource.data.orgId);
    }

    match /workspaceDatabases/{databaseId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg();
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        ('createdBy' in resource.data && request.auth.uid == resource.data.createdBy) ||
        ('creatorId' in resource.data && request.auth.uid == resource.data.creatorId) ||
        ('ownerId' in resource.data && request.auth.uid == resource.data.ownerId) ||
        isOrgAdminOrOwner(resource.data.orgId)
      );
    }

    // ─── CHAT MESSAGES & THREADS ────────────────────────────────────────────

    match /messages/{messageId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg() && request.resource.data.senderId == request.auth.uid;
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        resource.data.senderId == request.auth.uid ||
        isOrgAdminOrOwner(resource.data.orgId)
      );
    }

    match /messageReplies/{replyId} {
      allow read: if isMemberOfOrg(resource.data.orgId);
      allow create: if isNewDocInMyOrg() && request.resource.data.senderId == request.auth.uid;
      allow update: if isDocInMyOrg();
      allow delete: if isDocInMyOrg() && (
        resource.data.senderId == request.auth.uid ||
        isOrgAdminOrOwner(resource.data.orgId)
      );
    }

    match /directMessages/{threadId} {
      allow get: if isAuth() && (
        resource == null ||
        (isMemberOfOrg(resource.data.orgId) &&
         (request.auth.uid in resource.data.participants || isOrgOwner(resource.data.orgId)))
      );
      allow list: if isMemberOfOrg(resource.data.orgId) && (
        request.auth.uid in resource.data.participants ||
        isOrgOwner(resource.data.orgId)
      );
      allow create: if isNewDocInMyOrg() && request.auth.uid in request.resource.data.participants;
      allow update: if isDocInMyOrg() && request.auth.uid in resource.data.participants;
      allow delete: if isDocInMyOrg() && (
        request.auth.uid in resource.data.participants ||
        isOrgAdminOrOwner(resource.data.orgId)
      );
    }

    match /dmReadState/{docId} {
      allow read: if isAuth() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        (isMemberOfOrg("orgId" in resource.data && resource.data.orgId != "" ? resource.data.orgId : getDmOrgId(resource.data.dmId)) &&
         (resource.data.userId == request.auth.uid ||
          isOrgAdminOrOwner("orgId" in resource.data && resource.data.orgId != "" ? resource.data.orgId : getDmOrgId(resource.data.dmId))))
      );
      allow create, update: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        (isNewDocInMyOrg() || isMemberOfOrg(getDmOrgId(request.resource.data.dmId)));
      allow delete: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        (isMemberOfOrg("orgId" in resource.data && resource.data.orgId != "" ? resource.data.orgId : getDmOrgId(resource.data.dmId)) &&
         isOrgAdminOrOwner("orgId" in resource.data && resource.data.orgId != "" ? resource.data.orgId : getDmOrgId(resource.data.dmId)))
      );
    }

    // ─── NOTIFICATIONS ──────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      // Users can read, update, and delete notifications addressed to them (or org owner on workspace cleanup)
      allow read, update, delete: if isAuth() && (
        request.auth.uid == resource.data.recipientId ||
        isOrgOwner(resource.data.orgId)
      );
      // Allow creation of notifications for others in the same organization when actor matches caller
      allow create: if isAuth() &&
        isNewDocInMyOrg() &&
        request.resource.data.actor.id == request.auth.uid;
    }

    // ─── BANNED USERS ────────────────────────────────────────────────────────
    // Written when an org owner/admin deletes a member to block re-login.

    match /bannedUsers/{uid} {
      allow read: if isAuth() && (
        request.auth.uid == uid ||
        (userExists() && isOrgAdminOrOwner(getUserData().organizationId))
      );
      allow create, update, delete: if isAuth() &&
        userExists() &&
        isOrgAdminOrOwner(getUserData().organizationId);
    }

    // ─── DEMO REQUESTS (INBOUND LEADS FROM MARKETING WEBSITE) ──────────────────
    match /demoRequests/{requestId} {
      // Allow prospective leads from the marketing website to submit demo requests
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string;
      // Reading, updating, and deleting is reserved for backend APIs and SuperAdmins
      allow read, update, delete: if false;
    }

    // ─── DEFAULT DENY FALLBACK ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}